  <diagram name="PPDB Workflow" id="ppdb-workflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="PPDB Online — End-to-End Workflow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Step 1: Buka Halaman PPDB -->
        <mxCell id="step1" value="Pendaftar buka halaman PPDB&#xa;(public website)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Login atau Guest -->
        <mxCell id="dec1" value="Sudah punya akun?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="230" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Login flow -->
        <mxCell id="login" value="Login&#xa;(email + password)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBCFE8;strokeColor=#EC4899;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Pilih Form -->
        <mxCell id="step2" value="Pilih jenis form:&#xa;TPQ Ulinnuha / PAUD-TK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="320" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Backend: getFormSchema -->
        <mxCell id="schema" value="GET /api/v1/ppdb/schema?type=tpq&#xa;→ getFormSchema(formType)&#xa;Return JSON schema form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#F59E0B;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="840" y="320" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Render Form -->
        <mxCell id="step3" value="Render form dinamis&#xa;berdasarkan schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=11;" vertex="1">
          <mxGeometry x="600" y="420" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Fill Form -->
        <mxCell id="step4" value="Isi semua field&#xa;+ upload lampiran&#xa;(foto, akta, KK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="490" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Decision: Valid? -->
        <mxCell id="dec2" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="580" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Submit -->
        <mxCell id="submit" value="POST /api/v1/ppdb&#xa;action=submit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#F59E0B;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="840" y="580" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Save to Sheet -->
        <mxCell id="save" value="Simpan ke ppdb_registrations&#xa;status = pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A7F3D0;strokeColor=#10B981;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="680" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Send Email -->
        <mxCell id="email" value="Email konfirmasi&#xa;ke pendaftar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A7F3D0;strokeColor=#10B981;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="680" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Notif Admin -->
        <mxCell id="notifadm" value="Notifikasi&#xa;ke Admin TU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBCFE8;strokeColor=#EC4899;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="680" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Wait Review -->
        <mxCell id="wait" value="Menunggu review&#xa;Admin TU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="760" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Admin Review -->
        <mxCell id="review" value="Admin TU review&#xa;dokumen & data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBCFE8;strokeColor=#EC4899;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="840" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Decision Admin -->
        <mxCell id="dec3" value="Setuju?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="920" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Reject -->
        <mxCell id="reject" value="Reject + alasan&#xa;status = rejected&#xa;email notifikasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="320" y="920" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Convert Process -->
        <mxCell id="convert" value="Convert ke Siswa:&#xa;1. Buat student record\n2. Buat parent records\n3. Buat user accounts\n4. Buat enrollment\n5. Generate invoice SPP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A7F3D0;strokeColor=#10B981;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="840" y="920" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- Status Converted -->
        <mxCell id="converted" value="status = converted&#xa;Email selamat datang&#xa;ke orang tua" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A7F3D0;strokeColor=#10B981;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="600" y="1050" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="Selesai" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=12;fontStyle=1;" vertex="1" parent="1">
