        <mxCell id="rel-inv-s" value="N → 1" style="endArrow=ERmany;startArrow=ERone;html=1;strokeColor=#1F2937;strokeWidth=2;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="invoices" target="students">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- payments → invoices, students -->
        <mxCell id="rel-pay-i" value="N → 1" style="endArrow=ERmany;startArrow=ERone;html=1;strokeColor=#1F2937;strokeWidth=2;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="payments" target="invoices">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
